{
  "name": "sql-playground",
  "version": "2.0.0",
  "private": true,
  "description": "Offline-first SQL learning IDE with isolated SQLite workspaces",
  "scripts": {
    "setup": "node scripts/runtime.js scripts/setup.js",
    "dev": "node scripts/runtime.js scripts/demo.js",
    "demo": "node scripts/runtime.js scripts/demo.js",
    "stop": "node scripts/runtime.js scripts/stop.js",
    "reset": "node scripts/runtime.js scripts/reset.js",
    "build": "node scripts/runtime.js node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "start": "node scripts/runtime.js server/src/server.js",
    "test": "node scripts/runtime.js --test --test-concurrency=1 server/test/*.test.js",
    "check": "npm test && npm run build",
    "install:all": "npm install",
    "format": "node scripts/runtime.js node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node scripts/runtime.js node_modules/prettier/bin/prettier.cjs --check .",
    "preview:check": "node scripts/runtime.js scripts/preview-check.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.8.0",
    "codemirror": "^6.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "vite": "^8.3.1"
  }
}
