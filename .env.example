# Leave ports unset for automatic Windows-reservation fallback.
# PORT=15000
# FRONTEND_PORT=15173
# CLIENT_URL=http://localhost:15173
# Optional locally: a random persistent secret is generated in server/data.
SESSION_SECRET=
# Use a different cookie name when running two checkouts on localhost.
# SESSION_COOKIE_NAME=sql.google-side.sid
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:15000/api/auth/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Production requires a strong SESSION_SECRET and HTTPS CLIENT_URL.
# NODE_ENV=production
